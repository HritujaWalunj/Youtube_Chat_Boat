# Copy to .env and edit. Never commit .env (it is git-ignored).

# Provider pre-selected in the UI: ollama | openai
LLM_PROVIDER=ollama

# Only needed for OpenAI (or let each user paste their key in the UI)
OPENAI_API_KEY=

# Ollama models
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# OpenAI models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Transcript chunking (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200